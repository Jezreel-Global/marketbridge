# Neon / Vercel Postgres connection string (server-side only — never NEXT_PUBLIC_*)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional: gate /admin and /provider on public demos.
# Leave unset for open local browsing. Set a long random value on Vercel.
# Visitors enter the code at /demo-access; it is never embedded in a URL.
# DEMO_ACCESS_TOKEN=

# Only enable DB integration tests against a disposable non-production database.
# DATABASE_TEST_NON_PRODUCTION=YES
# DATABASE_TEST_DATABASE=marketplace_preview

# Clerk seller identity. Create a Clerk development instance to enable authentication.
# The publishable key is public; keep the secret key server-side only.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# CLERK_SECRET_KEY=sk_test_placeholder

# Clerk user IDs allowed to open /admin and use simulated admin controls.
# Server-only comma-separated allowlist; do not use emails or user-editable metadata.
# ADMIN_CLERK_USER_IDS=user_example123

# Blaaiz sandbox OAuth credentials are not consumed yet; no Blaaiz API flow is
# implemented. Add server-only credentials only after sandbox access is issued
# and the integration is implemented. Never use NEXT_PUBLIC_ for these values.
# BLAAIZ_CLIENT_ID=
# BLAAIZ_CLIENT_SECRET=
